# Variable vocabulary (PLAIN placeholders — never commit real values).
# Copy to .env and fill in real values. Never commit .env.

# --- Database (dev) ---
POSTGRES_DB=team_management
POSTGRES_USER=teammanagement
POSTGRES_PASSWORD=change-me

# --- App datasource ---
# Local app against compose Postgres: jdbc:postgresql://localhost:5432/team_management
DB_URL=jdbc:postgresql://localhost:5433/team_management
DB_USERNAME=teammanagement
DB_PASSWORD=change-me

# --- OIDC (Keycloak) ---
# Issuer URI must equal the browser-facing Keycloak base + /realms/team-management exactly.
JWT_ISSUER_URI=http://localhost:8082/realms/team-management
# Browser-facing legs (PUBLIC):
KEYCLOAK_AUTHORIZATION_URI=http://localhost:8082/realms/team-management/protocol/openid-connect/auth
KEYCLOAK_END_SESSION_URI=http://localhost:8082/realms/team-management/protocol/openid-connect/logout
# Server legs (INTERNAL: compose service name in deployment; localhost locally):
KEYCLOAK_TOKEN_URI=http://localhost:8082/realms/team-management/protocol/openid-connect/token
KEYCLOAK_JWK_SET_URI=http://localhost:8082/realms/team-management/protocol/openid-connect/certs
# Expected `aud` for access tokens.
APP_AUDIENCE=team-management-api
# Web client (authorization code flow).
KC_WEB_CLIENT_ID=team-management-web
KC_WEB_CLIENT_SECRET=dev-web-secret
KC_WEB_REDIRECT_URI={baseUrl}/login/oauth2/code/keycloak

# --- Keycloak console bootstrap (dev defaults; rotate for deployment) ---
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me

# --- Uploads (player photos / team logos) ---
UPLOADS_DIR=uploads

# --- Docs/UI (production profile switch, off unless needed) ---
SPRINGDOC_ENABLED=false
